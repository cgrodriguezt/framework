# Application configuration
APP_NAME="Orionis"
APP_ENV="development"
APP_DEBUG=true
APP_TIMEZONE="UTC"
APP_LOCALE="en"
APP_FALLBACK_LOCALE="en"
APP_LANGUAGE_PATH="resources/lang/"
APP_CIPHER="AES-256-CBC"
APP_KEY=""
APP_MAINTENANCE=false

# Cache configuration
CACHE_STORE="memory"
CACHE_PREFIX=""
CACHE_FILE_PATH="storage/framework/cache"


# HTTP configuration
TRUSTED_PROXIES="list:[]"

ALLOWED_HOSTS="list:[]"

RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

CORS_ALLOW_ORIGINS="list:[]"
CORS_ALLOW_ORIGIN_REGEX=null
CORS_ALLOW_METHODS="list:[]"
CORS_ALLOW_HEADERS="list:[]"
CORS_EXPOSE_HEADERS="list:[]"
CORS_ALLOW_CREDENTIALS=false
CORS_MAX_AGE=600

# Logging configuration
LOG_CHANNEL="stack"

# Session configuration
SESSION_DRIVER="file"
SESSION_LIFETIME=120
SESSION_EXPIRE_ON_CLOSE=false
SESSION_FILES="storage/framework/sessions"
SESSION_COOKIE="sessionid"
SESSION_PATH="/"
SESSION_DOMAIN=null
SESSION_SECURE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE="lax"
SESSION_PARTITIONED=false

# Testing configuration
TESTING_VERBOSITY=2
TESTING_FAIL_FAST=false
TESTING_START_DIR="tests"
TESTING_FILE_PATTERN="test_*.py"
TESTING_METHOD_PATTERN="test*"
TESTING_CACHE_RESULTS=false